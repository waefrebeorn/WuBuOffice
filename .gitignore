# Build trees (configured per-session)
/build/
/build-san/

# All font banks are LOCAL artifacts (OFL fonts + generated glyf/rasterized
# banks). Originals are re-fetched by the corpus tools; generated banks are
# produced locally by tools/otf_to_glyf.py + the flatten step. Never commit.
/fonts/

# All dataset corpora are LOCAL artifacts (EMNIST IDX, generated synthetic
# datasets). Re-downloaded / regenerated by the dataset tools. Never commit.
/data/

# Generated training dataset (tools/gen_dataset.py output).
/data/synthetic_corpus/

